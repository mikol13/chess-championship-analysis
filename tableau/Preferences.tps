<?xml version='1.0'?>
<workbook>
  <preferences>
    <!-- Chess Analytics palettes (navy, gold, teal, red, grey, green, purple, sand). -->

    <!-- Categorical: use for dimensions (skill level, victory status, time category, ...) -->
    <color-palette name="Chess Analytics" type="regular">
      <color>#1F3A5F</color>
      <color>#E9B44C</color>
      <color>#2A9D8F</color>
      <color>#C8553D</color>
      <color>#8D99AE</color>
      <color>#6A994E</color>
      <color>#5C4D7D</color>
      <color>#F2CC8F</color>
    </color-palette>

    <!-- Diverging: for scores centred on 0.5 (red = low, navy = high). In Edit Colors > Advanced,
         tick Center and enter 0.5 so the middle colour sits on a balanced score. -->
    <color-palette name="Chess Analytics Diverging" type="ordered-diverging">
      <color>#C8553D</color>
      <color>#F2CC8F</color>
      <color>#1F3A5F</color>
    </color-palette>

    <!-- Sequential: for counts and intensity heatmaps -->
    <color-palette name="Chess Analytics Sequential" type="ordered-sequential">
      <color>#F3F4F6</color>
      <color>#8D99AE</color>
      <color>#1F3A5F</color>
    </color-palette>
  </preferences>
</workbook>
